# ==============================================================================
# AdaptiveMLOps Environment Configuration Template
# Copy this file to .env (or backend/.env) and populate with your environment values.
# NEVER commit real passwords or production API keys to version control.
# ==============================================================================

# --- Database Configuration ---
# You can provide a full connection string:
# SQLALCHEMY_DATABASE_URI=postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
# Or configure component variables:
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=adaptive_mlops
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_database_password_here
DATABASE_SSL_MODE=prefer

# --- Remote InsForge Project Configuration ---
INSFORGE_PROJECT_URL=https://bdrb7j6b.ap-southeast.insforge.app
INSFORGE_API_KEY=your_insforge_api_key_here
INSFORGE_ANON_KEY=your_insforge_anon_key_here

# --- Application Security & Demo Configuration ---
SECRET_KEY=change_this_to_a_secure_random_secret_in_production
ADMIN_API_KEY=change_this_to_a_secure_admin_api_key
ENABLE_DEMO_MODE=true
DEBUG=False
ENVIRONMENT=development
